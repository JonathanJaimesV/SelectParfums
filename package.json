{
  "name": "selectparfums",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/gen-image-manifest.mjs",
    "prebuild": "node scripts/gen-image-manifest.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test": "node --test",
    "images:thumbs": "node scripts/make-thumbs.mjs",
    "db:seed": "node scripts/export-seed-sql.mjs",
    "db:seed:check": "node scripts/export-seed-sql.mjs --check",
    "db:check": "node scripts/sql/check-migration.mjs",
    "test:sql": "bash supabase/tests/run-selftest.sh",
    "test:sql:concurrency": "bash supabase/tests/concurrency.sh"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
