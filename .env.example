# Copia este archivo a .env.local (NO lo subas a Git: .gitignore ya lo excluye) o define estas variables en Netlify.
# ⚠ Las variables VITE_* son PÚBLICAS: terminan dentro del JavaScript que descarga cualquier visitante.
#    Nunca pongas aquí la clave service_role / secret, contraseñas ni tokens privados.

# Número de WhatsApp del negocio (código de país + número, sin signos). Opcional: si no se define se usa src/config.js
VITE_WHATSAPP_NUMBER=

# Supabase (PÚBLICAS). Project Settings → API:
#   URL            → https://<tu-ref>.supabase.co
#   anon/publishable → la clave "anon" (JWT) o "publishable" (sb_publishable_…). NUNCA la "service_role" ni "secret".
# Si faltan, la tienda funciona igual que antes (checkout por WhatsApp directo, sin registrar pedidos).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
